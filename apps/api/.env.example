# Copie para .env. Valores de dev, batem com infra/docker-compose.yml.
# API conecta como despacho_app (sujeito a RLS); migrations rodam como despacho (dono das tabelas).
DATABASE_URL=postgres://despacho_app:despacho_app@localhost:5433/despacho
MIGRATION_DATABASE_URL=postgres://despacho:despacho@localhost:5433/despacho
REDIS_URL=redis://localhost:6379/0
PORT=3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:8081
# Bairro do pedido por geocodificação reversa: nominatim (OpenStreetMap, gratuito, 1 req/s) ou none.
GEOCODER=nominatim
# Fotos do pedido e do chat: Cloudflare R2 (ADR 0009), um bucket por ambiente. Sem isso a API sobe, mas recusa fotos.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=despacho-dev
